# ── LinkedIn profile provider ─────────────────────────────────────────────────
# Proxycurl shut down mid-2025 (LinkedIn filed a federal lawsuit).
# Choose one provider and set its key below.
#
#   "netrows"    — https://netrows.com  (~$0.01-0.05/call, Proxycurl-compatible)
#   "pdl"        — https://peopledatalabs.com  (~$0.08/record, large database)
#   "brightdata" — https://brightdata.com  (enterprise, legally defensible)

LINKEDIN_PROVIDER=netrows

# Netrows (recommended — easiest drop-in)
NETROWS_API_KEY=your_netrows_api_key_here

# People Data Labs (alternative)
# PDL_API_KEY=your_pdl_api_key_here

# Bright Data (enterprise, requires a LinkedIn Profiles dataset ID)
# BRIGHTDATA_API_KEY=your_brightdata_api_key_here
# BRIGHTDATA_DATASET_ID=your_dataset_id_here

# ── Apollo.io (prospect search — recommended, free tier available) ─────────────
# https://app.apollo.io/#/settings/integrations/api
# The people search endpoint is FREE (no credits). Credits only for enrichment.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Anthropic (required only for --generate, narrative generation) ────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional tuning ───────────────────────────────────────────────────────────
# MAX_COMPANIES_TO_SEARCH=10
# MAX_PROSPECTS_PER_COMPANY=25
# MIN_RELATIONSHIP_SCORE=20
