# ── PDL (People Data Labs) — FREE, required ───────────────────────────────────
# Used for both prospect search AND referral source profile lookup.
# Free tier: 1,000 API calls/month — no credit card needed.
# Sign up at https://www.peopledatalabs.com
PDL_API_KEY=your_pdl_api_key_here

# ── Google Gemini — FREE, required for --generate ─────────────────────────────
# Free tier: 1,500 requests/day — no credit card needed.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── Optional tuning ───────────────────────────────────────────────────────────
# MAX_COMPANIES_TO_SEARCH=10
# MAX_PROSPECTS_PER_COMPANY=25
# MIN_RELATIONSHIP_SCORE=20
