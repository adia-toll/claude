# ── Apollo.io — FREE, required ────────────────────────────────────────────────
# Used for both prospect search AND referral source profile lookup.
# Free tier at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=your_apollo_api_key_here

# ── Google Gemini — FREE, required for --generate ─────────────────────────────
# Free tier: 1,500 requests/day, no credit card needed.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── That's it for free usage ──────────────────────────────────────────────────
# The defaults (LINKEDIN_PROVIDER=apollo, AI_PROVIDER=gemini) use only the
# two keys above. Everything else below is optional / paid.

# ── Paid LinkedIn providers (optional, better profile data) ──────────────────
# LINKEDIN_PROVIDER=netrows  →  NETROWS_API_KEY=...   (https://netrows.com)
# LINKEDIN_PROVIDER=pdl      →  PDL_API_KEY=...       (https://peopledatalabs.com)
# LINKEDIN_PROVIDER=brightdata → BRIGHTDATA_API_KEY=... + BRIGHTDATA_DATASET_ID=...

# ── Paid AI (optional, higher quality narratives) ─────────────────────────────
# AI_PROVIDER=anthropic  →  ANTHROPIC_API_KEY=...     (https://console.anthropic.com)

# ── Optional tuning ───────────────────────────────────────────────────────────
# MAX_COMPANIES_TO_SEARCH=10
# MAX_PROSPECTS_PER_COMPANY=25
# MIN_RELATIONSHIP_SCORE=20
